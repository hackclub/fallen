# Production environment variables (set these on the web and worker services).

DATABASE_URL=
SECRET_KEY_BASE=                            # bin/rails secret
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=       # bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
APP_HOST=app.example.com
APP_URL=https://app.example.com
HASHID_SALT=

# Hack Club Auth
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_JOURNALS_CHANNEL_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
SLACK_BROWSER_TOKEN=                        # xoxc- token of an account in the journals channel (bin/slack-typing)
SLACK_BROWSER_COOKIE=                       # its `d` cookie
SLACK_HUDDLE_CHANNEL_ID=                    # channel where that account sits in a huddle around the clock (script/slack_huddle.mjs)
PROMETHEUS_API_KEY=                         # Prometheus key for the journals channel; deletes posts Fallen did not write

# Airtable. Every user is uploaded to a Sync API table every 5 minutes (AirtableUsers). Leave the key empty to turn it off.
AIRTABLE_API_KEY=                           # personal access token: data.records:write and schema.bases:write on the base
AIRTABLE_BASE_ID=
AIRTABLE_USERS_TABLE=Users                  # the Sync API table's name or id
AIRTABLE_USERS_SYNC_ID=                     # shown when setting up the Sync API table, and in its sync settings

# Cloudflare R2 (Active Storage). Leave R2_BUCKET empty to store uploads on local disk.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Mail via Loops
LOOPS_API_KEY=
MAILER_FROM=

# Monitoring
SENTRY_DSN=
SENTRY_FRONTEND_DSN=         # browser errors; separate Sentry project

# Set to run Solid Queue inside the web container instead of a separate worker.
# SOLID_QUEUE_IN_PUMA=1

# Capacity. Puma runs WEB_CONCURRENCY processes of RAILS_MAX_THREADS threads; the DB pool follows the thread count.
# A statement over DB_STATEMENT_TIMEOUT is killed (docs/performance.md).
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=3
# DB_STATEMENT_TIMEOUT=5s
