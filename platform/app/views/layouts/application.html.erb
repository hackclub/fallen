<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Fallen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=UoqMunThenKhung&display=swap">
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "application" %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased dark:bg-stone-950 dark:text-stone-100">
    <main class="mx-auto max-w-3xl p-6"><%= yield %></main>
  </body>
</html>
