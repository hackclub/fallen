<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Fallen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if ENV["SENTRY_FRONTEND_DSN"].present? %><meta name="sentry-dsn" content="<%= ENV["SENTRY_FRONTEND_DSN"] %>"><% end %>
    <%# Lets the browser's page-load trace continue this request's trace. %>
    <% Sentry.get_trace_propagation_headers&.each do |name, content| %><%= tag.meta(name:, content:) %><% end %>

    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia" %>
    <%= inertia_page_preload_tags %>
    <%= inertia_ssr_head %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased dark:bg-stone-950 dark:text-stone-100">
    <%= yield %>
  </body>
</html>
