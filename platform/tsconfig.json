{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "svelte"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/frontend/*"],
      "@desk/*": ["vendor/desk/frontend/*"]
    }
  },
  "exclude": ["node_modules", "vendor/bundle", "vendor/javascript", "public", "tmp"],
  "include": [
    "app/frontend/**/*.ts",
    "app/frontend/**/*.svelte",
    "app/frontend/**/*.js",
    "vite.config.ts",
    "vendor/desk/frontend/**/*"
  ]
}
