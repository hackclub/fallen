#!/usr/bin/env ruby
# Prints a Slack app manifest for this app. Usage:
#   bin/slack-manifest                       # uses APP_URL / APP_HOST
#   bin/slack-manifest https://my.app.com    # explicit public URL
#   bin/slack-manifest --socket-mode         # for local dev with script/slack_socket_mode.mjs
#   bin/slack-manifest --json                # what the Slack CLI reads (.slack/hooks.json get-manifest)
require_relative "../config/environment"

socket_mode = ARGV.delete("--socket-mode")
json = ARGV.delete("--json")
url = ARGV.reject { |a| a.start_with?("--") }.first.presence || ENV["APP_URL"].presence || (ENV["APP_HOST"].present? ? "https://#{ENV['APP_HOST']}" : "https://example.com")
name = ENV.fetch("SLACK_APP_NAME", Rails.application.class.module_parent_name)

options = { app_url: url.chomp("/"), name: name, socket_mode: socket_mode.present? }
puts json ? SlackBot::Manifest.to_json(**options) : SlackBot::Manifest.to_yaml(**options)
