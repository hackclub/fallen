#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare_or_wait

  # Kubernetes sends SIGTERM at the same time as it starts taking the pod out of the load balancer, so for a moment
  # requests still arrive. Keep answering them for a few seconds, then let Puma finish what it has and stop.
  "${@}" &
  server=$!
  trap 'sleep "${SHUTDOWN_DELAY:-5}"; kill -TERM "$server"' TERM INT
  set +e
  wait "$server"
  status=$?
  if kill -0 "$server" 2>/dev/null; then # the first wait was cut short by the signal
    wait "$server"
    status=$?
  fi
  exit $status
fi

exec "${@}"
