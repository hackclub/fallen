#!/usr/bin/env ruby
# Watches the journals channel for people starting a top-level post and sends them a hint (TypingHintJob).
# Slack only reports typing to its own clients, so this signs in as a person who is in the journals channel:
# SLACK_BROWSER_TOKEN is their xoxc- token and SLACK_BROWSER_COOKIE their `d` cookie. Idles when they are not set.
require_relative "../config/environment"

$stdout.sync = true
token = ENV["SLACK_BROWSER_TOKEN"].presence
cookie = ENV["SLACK_BROWSER_COOKIE"].presence
channel = SlackMessaging.journals_channel_id

unless token && cookie && channel && SlackBot.configured?
  puts "[slack-typing] SLACK_BROWSER_TOKEN, SLACK_BROWSER_COOKIE, SLACK_JOURNALS_CHANNEL_ID or SLACK_BOT_TOKEN not set - idle."
  sleep
end

SlackBot::BrowserSocket.new(token: token, cookie: cookie).run do |event|
  next unless event["type"] == "user_typing" && event["channel"] == channel && event["thread_ts"].blank?

  TypingHintJob.hint(event["user"], channel)
end
