#!/usr/bin/env ruby
# Listens on Slack's own real-time socket, signed in as the user bot (SLACK_BROWSER_TOKEN is its xoxc- token and
# SLACK_BROWSER_COOKIE its `d` cookie), for events the Events API never sends:
# - someone starting a top-level post in the journals channel, to send them a hint (TypingHintJob)
# - people joining and leaving the bot's huddle, and the huddle ending (HuddleSyncJob)
# Idles when the credentials are not set or there is nothing to watch.
require_relative "../config/environment"

$stdout.sync = true
token = ENV["SLACK_BROWSER_TOKEN"].presence
cookie = ENV["SLACK_BROWSER_COOKIE"].presence
channel = SlackMessaging.journals_channel_id if SlackBot.configured?
huddle = SlackHuddle.configured?

unless token && cookie && (channel || huddle)
  puts "[slack-typing] SLACK_BROWSER_TOKEN, SLACK_BROWSER_COOKIE and SLACK_JOURNALS_CHANNEL_ID or SLACK_HUDDLE_CHANNEL_ID not set - idle."
  sleep
end

SlackBot::BrowserSocket.new(token: token, cookie: cookie).run do |event|
  if channel && event["type"] == "user_typing" && event["channel"] == channel && event["thread_ts"].blank?
    TypingHintJob.hint(event["user"], channel)
  elsif huddle && %w[sh_room_join sh_room_leave sh_room_update].include?(event["type"])
    HuddleSyncJob.perform_later
  end
end
