#!/bin/bash
# The worker container (Dockerfile.worker): Solid Queue, the Slack typing watcher and the huddle keeper, which
# share the user bot's secrets. If any of them stops, the others are stopped too so the container exits and gets
# restarted.

# The web container migrates too, but this one can boot first and would run new code against the old schema, so a
# failed migration stops the container rather than starting the jobs.
./bin/rails db:prepare_or_wait || exit

./bin/jobs &
./bin/slack-typing &
node script/slack_huddle.mjs &

trap 'kill -TERM $(jobs -p) 2>/dev/null; wait' TERM INT

wait -n
status=$?
kill -TERM $(jobs -p) 2>/dev/null
wait
exit $status
