# Bundler
/.bundle

# Environment files (keep the examples)
/.env*
!/.env*.example

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Uploaded files and local storage
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Compiled assets
/public/assets
/public/vite*
/app/assets/builds/*
!/app/assets/builds/.keep

# Secrets
/config/master.key
/config/credentials/*.key

# Node
node_modules
*.local
.svelte-kit

# Editors / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# Dumps and data
*.sql
*.dump
*.csv

# Slack CLI state (app ids per team, cache)
/.slack/apps*.json
/.slack/cache/
/tmp/slack_install.json

# Svelte plugin cache
/app/frontend/.vite/
