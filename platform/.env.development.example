# Copy to .env.development (gitignored). Loaded by dotenv-rails and script/slack_socket_mode.mjs.

# Postgres. `docker compose up -d` provides one matching this URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fallen_development

# Public URL of this app (used for OAuth callbacks and the Slack manifest).
APP_URL=http://localhost:3000

# Hack Club Auth. Create an app at https://auth.hackclub.com (dev uses the staging instance).
# Callback URL: http://localhost:3000/auth/hca/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Slack app. Create one from `bin/slack-manifest --socket-mode` at https://api.slack.com/apps
SLACK_BOT_TOKEN=            # xoxb-… (OAuth & Permissions -> Bot User OAuth Token)
SLACK_SIGNING_SECRET=       # Basic Information -> App Credentials
SLACK_APP_TOKEN=            # xapp-… with connections:write (Basic Information -> App-Level Tokens). Enables Socket Mode locally.

# Optional
# HASHID_SALT=change-me
# SENTRY_DSN=
